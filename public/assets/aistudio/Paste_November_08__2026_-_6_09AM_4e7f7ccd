                    <label className="text-[11px] font-mono text-slate-400 block mb-1">Celular (WhatsApp / SMS)</label>
                    <input type="text" value={clientPhone} onChange={(e) => setClientPhone(e.target.value)} className="w-full bg-[#080B11] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100" required />
                  </div>
                </div>

                <div className="space-y-4 bg-[#151C2C]/50 border border-slate-800 p-5 rounded-2xl">
                  {paymentMethod === 'credit_card' ? (
                    <>
                      <h3 className="text-xs font-bold text-slate-200 uppercase">Dados do Cartão (PCI-DSS Blindado)</h3>
                      <input type="text" placeholder="Número do Cartão" value={cardNumber} onChange={(e) => setCardNumber(e.target.value)} className="w-full bg-[#080B11] border border-slate-800 rounded-xl px-3 py-2 text-xs text-cyan-300 font-mono" required />
                      <input type="text" placeholder="Nome Impresso" value={cardHolder} onChange={(e) => setCardHolder(e.target.value)} className="w-full bg-[#080B11] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-100 uppercase" required />
                      <div className="grid grid-cols-2 gap-3">
                        <input type="text" placeholder="MM/AA" value={cardExpiry} onChange={(e) => setCardExpiry(e.target.value)} className="bg-[#080B11] border border-slate-800 rounded-xl px-3 py-2 text-xs text-center text-slate-100" required />
                        <input type="password" placeholder="CVV" maxLength={4} value={cardCvv} onChange={(e) => setCardCvv(e.target.value)} className="bg-[#080B11] border border-slate-800 rounded-xl px-3 py-2 text-xs text-center text-slate-100" required />
                      </div>
                    </>
                  ) : (
                    <div className="text-center space-y-2 py-4">
                      <QrCode className="w-20 h-20 text-emerald-400 mx-auto" />
                      <p className="text-xs text-slate-300">Escaneie o QR Code para pagamento instantâneo via PIX.</p>
                    </div>
                  )}

                  <button type="submit" disabled={isProcessingCheckout} className="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-cyan-600 text-white font-bold text-xs flex items-center justify-center gap-2">
                    {isProcessingCheckout ? <RefreshCw className="w-4 h-4 animate-spin" /> : <Lock className="w-4 h-4" />}
                    <span>{isProcessingCheckout ? 'Tokenizando Cartão & Gerando Fatura...' : 'Pagar R$ 149,00 via Mercado Pago'}</span>
                  </button>
                </div>
              </form>

              {invoiceGenerated && (
                <div className="bg-[#151C2C] border border-emerald-500/50 rounded-2xl p-4 text-xs font-mono space-y-2">
                  <div className="text-emerald-400 font-bold">✅ Fatura {invoiceGenerated.id} emitida com sucesso!</div>
                  <div className="text-slate-300">Disparada para WhatsApp: {invoiceGenerated.clientPhone} e E-mail: {invoiceGenerated.clientEmail}</div>
                </div>
              )}
            </div>
          )}

          {/* MÓDULO GITHUB OFICIAL API */}
          {activeTab === 'github' && (
            <div className="bg-[#0D121F] border border-indigo-500/40 rounded-3xl p-6 shadow-2xl space-y-6">
              <h2 className="text-lg font-bold text-white flex items-center gap-2">
                <GitBranch className="w-5 h-5 text-indigo-400" />
                <span>Gestão Oficial de Repositórios GitHub na vpsNsA</span>
              </h2>

              {!isGitHubConnected ? (
                <form onSubmit={handleFetchGitHubRepos} className="flex flex-col md:flex-row gap-3">
                  <input type="password" placeholder="Insira seu Personal Access Token (ghp_...)" value={accessToken} onChange={(e) => setAccessToken(e.target.value)} className="flex-1 bg-[#080B11] border border-slate-800 rounded-xl px-4 py-2.5 text-xs font-mono text-slate-100" required />
                  <button type="submit" disabled={isFetchingGitHub} className="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-6 py-2.5 rounded-xl">
                    {isFetchingGitHub ? 'A carregar...' : 'Carregar Repositórios Reais'}
                  </button>
                </form>
              ) : (
                <div className="space-y-3 max-h-[400px] overflow-y-auto">
                  {gitHubRepos.map((repo) => (
                    <div key={repo.id} className="bg-[#151C2C] border border-slate-800 rounded-2xl p-4 flex items-center justify-between">
                      <div>
                        <span className="font-bold text-white font-mono text-xs">{repo.full_name}</span>
                        <p className="text-[11px] text-slate-400 font-mono">{repo.description || 'Sem descrição.'}</p>
                      </div>
                      <a href={repo.html_url} target="_blank" rel="noopener noreferrer" className="px-3 py-1.5 bg-slate-800 text-cyan-400 rounded-xl text-xs font-mono flex items-center gap-1">
                        <span>Ver no GitHub</span>
                        <ExternalLink className="w-3 h-3" />
                      </a>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

        </main>
      </div>

      {/* RODAPÉ */}
      <footer className="w-full bg-[#0D121F] border-t border-indigo-500/20 px-6 py-2 flex items-center justify-between text-[11px] text-slate-500">
        <span>© 2026 vpsNsA Sovereign Cloud — www.nsaoficial.com.br</span>
        <span className="font-semibold text-slate-400">CEO Márcio Francisco de Almeida</span>
      </footer>

    </div>
  );
}

export default App;
